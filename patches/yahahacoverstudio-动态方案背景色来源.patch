   name: string
   size: string
@@ -2354,6 +2379,10 @@ function syncAnimatedSettings(data?: Partial<StatusPayload> | null, baseStyle: C
   animatedSettings.blurSize = clampNumber(source.blur_size ?? animatedSettings.blurSize, 0, 100, 50)
   animatedSettings.colorRatio = clampFloat(source.color_ratio ?? animatedSettings.colorRatio, 0, 1, 0.8)
   animatedSettings.titleScale = clampFloat(source.title_scale ?? animatedSettings.titleScale, 0.2, 3, 1)
+  animatedSettings.bgColorMode = ['auto', 'custom', 'config'].includes(String(source.bg_color_mode))
+    ? source.bg_color_mode as 'auto' | 'custom' | 'config'
+    : 'auto'
+  animatedSettings.customBgColor = String(source.custom_bg_color || animatedSettings.customBgColor || '')
 }
 
