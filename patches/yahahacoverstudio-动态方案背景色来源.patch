     await setCoverStyle(item.baseStyle, 'animated')
   }
   syncAnimatedSettings(null, item.baseStyle)
+  simulationParams.colorSource = animatedSettings.bgColorMode
+  simulationParams.customColor = animatedSettings.customBgColor || defaultAnimatedBgColor
 }
 
