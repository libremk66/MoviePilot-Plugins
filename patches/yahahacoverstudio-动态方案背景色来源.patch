+  { title: '从主图自动取色', value: 'auto' },
+  { title: '手动指定', value: 'custom' },
+  { title: '配置指定', value: 'config' },
+]
+
 const animatedSettingsTitle = computed(() => {
   const index = animatedSettingsBaseStyle.value.split('_')[1] || '1'
   return `动态方案 ${index} 配置`
