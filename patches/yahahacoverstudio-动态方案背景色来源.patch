   previewBayHeight.value > 0
@@ -1399,6 +1414,16 @@ const simulationParams = reactive<SimulationParams>({
   customColor: getThemeColor('--mcr-cover-auto-blend'),
 })
 
+// 动态方案的背景色来源改动后，同步到页面模拟预览，保证预览与生成一致
+watch(
+  () => [animatedSettings.bgColorMode, animatedSettings.customBgColor] as const,
+  () => {
+    if (!animatedSettingsPanelOpen.value) return
+    simulationParams.colorSource = animatedSettings.bgColorMode
+    simulationParams.customColor = animatedSettings.customBgColor || defaultAnimatedBgColor
+  },
+)
+
