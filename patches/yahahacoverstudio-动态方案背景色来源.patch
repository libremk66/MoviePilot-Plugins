       blur_size: animatedSettings.blurSize,
       color_ratio: animatedSettings.colorRatio,
       title_scale: animatedSettings.titleScale,
+      bg_color_mode: animatedSettings.bgColorMode,
+      custom_bg_color: animatedSettings.bgColorMode === 'custom'
+        ? (animatedSettings.customBgColor || defaultAnimatedBgColor)
+        : animatedSettings.customBgColor,
     }
     const resp = await props.api.post<{
       code: number
@@ -2577,6 +2612,12 @@ const animatedDepartureItems = [
   { title: '渐变', value: 'crossfade' },
 ]
 
